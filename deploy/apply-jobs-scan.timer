[Unit]
Description=Schedule apply-jobs-mcp public scans (07:00, every 3 days)

[Timer]
# Days 1, 4, 7, ... of each month => every 3 days at 07:00 local time.
# (Timezone= option needs systemd >= 256; on newer systemd add Timezone=Asia/Kolkata)
OnCalendar=*-*-1/3 07:00:00
RandomizedDelaySec=120
Persistent=true
Unit=apply-jobs-scan.service

[Install]
WantedBy=timers.target
